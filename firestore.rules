rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    // Guarded with exists() first — calling get() on a document that
    // doesn't exist yet (e.g. during first-run admin bootstrap, before
    // the user's own profile doc has been written) throws and denies the
    // whole rule instead of just evaluating false, so every check here
    // checks existence before reading.
    function hasProfile() {
      return isSignedIn() && exists(userDocPath());
    }

    function isActive() {
      return hasProfile() && get(userDocPath()).data.status == 'active';
    }

    function isAdmin() {
      return isActive() && get(userDocPath()).data.role == 'administrator';
    }

    function isAssignedWorker(field) {
      return isActive() && request.auth.uid in resource.data[field];
    }

    function isAssignedWorkerOnCreate(field) {
      return isActive() && request.auth.uid in request.resource.data[field];
    }

    function systemInitialized() {
      return exists(/databases/$(database)/documents/meta/systemInfo)
        && get(/databases/$(database)/documents/meta/systemInfo).data.adminCreated == true;
    }

    // ---- Meta (first-run bootstrap flag) ----
    // Publicly readable (the login screen needs to know whether to show
    // "set up admin" vs. the normal login form, before anyone is signed
    // in). Writable exactly once: false -> true, never editable again.
    match /meta/systemInfo {
      allow read: if true;
      allow create: if request.resource.data.adminCreated == true;
      allow update, delete: if false;
    }

    // ---- Login ID -> email lookup ----
    // Publicly readable by design — it's how the login screen resolves a
    // Worker ID to the synthetic email Firebase Auth needs. Nothing secret
    // lives here (no PIN, no name). Only admins can write it, except during
    // first-run bootstrap when no admin exists yet.
    match /loginIds/{loginId} {
      allow get: if true;
      allow list: if false; // no enumeration of all login IDs
      allow create: if isAdmin() || !systemInitialized();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---- Users ----
    // Any active user can read the directory (needed to show co-workers
    // when sharing a disciple) — names/roles aren't sensitive in an
    // internal church tool. Only admins can create/update OTHER users;
    // the bootstrap admin can create their own doc once, before any admin
    // exists.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isActive());
      allow create: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == 'administrator'
            && !systemInitialized());
      // Admins can update any profile. Every signed-in user may update ONLY the
      // lastLoginAt field on their OWN profile — never role, status or loginId.
      allow update: if isAdmin()
        || (isActive() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']));
      allow delete: if isAdmin(); // used only to clean up the old doc after a PIN reset
    }

    // ---- Disciples ----
    // Admins: full access. Workers: read/write only disciples they're
    // assigned to — a disciple can have multiple assigned workers.
    match /disciples/{id} {
      allow read: if isAdmin() || isAssignedWorker('assignedWorkerIds');
      allow create: if isAdmin() || (isActive() && isAssignedWorkerOnCreate('assignedWorkerIds'));
      allow update, delete: if isAdmin() || isAssignedWorker('assignedWorkerIds');
    }

    // ---- Evangelism records ----
    match /evangelismRecords/{id} {
      allow read: if isAdmin() || isAssignedWorker('assignedWorkerIds');
      allow create: if isActive();
      allow update: if isAdmin() || isAssignedWorker('assignedWorkerIds');
      allow delete: if isAdmin();
    }

    // ---- Follow-ups ----
    match /followUps/{id} {
      allow read: if isAdmin() || (isActive() && resource.data.workerId == request.auth.uid);
      allow create: if isActive();
      allow update: if isAdmin() || (isActive() && resource.data.workerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // ---- Attendance sessions ----
    match /attendanceSessions/{id} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // ---- Audit logs ----
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }
  }
}
