rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(userDocPath());
    }

    function isActive() {
      return hasProfile() && get(userDocPath()).data.status == 'active';
    }

    function isAdmin() {
      return isActive() && get(userDocPath()).data.role == 'administrator';
    }

    function isAssignedWorker(field) {
      return isActive() && request.auth.uid in resource.data[field];
    }

    function isAssignedWorkerOnCreate(field) {
      return isActive() && request.auth.uid in request.resource.data[field];
    }

    function isAssignedToDisciple(discipleId) {
      return exists(/databases/$(database)/documents/disciples/$(discipleId))
        && request.auth.uid in get(/databases/$(database)/documents/disciples/$(discipleId)).data.assignedWorkerIds;
    }

    function systemInitialized() {
      return exists(/databases/$(database)/documents/meta/systemInfo)
        && get(/databases/$(database)/documents/meta/systemInfo).data.adminCreated == true;
    }

    match /meta/systemInfo {
      allow read: if true;
      allow create: if request.resource.data.adminCreated == true;
      allow update, delete: if false;
    }

    match /loginIds/{loginId} {
      allow get: if true;
      allow list: if false;
      allow create: if isAdmin() || !systemInitialized();
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isActive());
      allow create: if isAdmin()
        || (request.auth.uid == uid
            && request.resource.data.role == 'administrator'
            && !systemInitialized());
      allow update: if isAdmin()
        || (isActive() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']));
      allow delete: if isAdmin();
    }

    match /disciples/{id} {
      allow read: if isAdmin() || isAssignedWorker('assignedWorkerIds');
      allow create: if isAdmin() || (isActive() && isAssignedWorkerOnCreate('assignedWorkerIds'));
      allow update, delete: if isAdmin() || isAssignedWorker('assignedWorkerIds');
    }

    match /evangelismRecords/{id} {
      allow read: if isAdmin() || isAssignedWorker('assignedWorkerIds');
      allow create: if isActive();
      allow update: if isAdmin() || isAssignedWorker('assignedWorkerIds');
      allow delete: if isAdmin();
    }

    match /followUps/{id} {
      allow read: if isAdmin() || (isActive() && resource.data.workerId == request.auth.uid);
      allow create: if isActive();
      allow update: if isAdmin() || (isActive() && resource.data.workerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /attendanceSessions/{id} {
      allow read: if isActive();
      allow create, update: if isActive();
      allow delete: if isAdmin();
    }

    // Published events are visible to all active users; only administrators
    // can create, edit, publish, archive or delete church announcements.
    match /attendanceRecords/{recordId} {
      allow read: if isAdmin() || (isActive() && (
        resource.data.personId == request.auth.uid
        || (resource.data.personType == 'disciple' && isAssignedToDisciple(resource.data.personId))
      ));
      allow create: if isActive() && request.resource.data.recordedBy == request.auth.uid && (
        (request.resource.data.method == 'self_recorded' && request.resource.data.personId == request.auth.uid)
        || (request.resource.data.method == 'worker_recorded' && (isAdmin() || isAssignedToDisciple(request.resource.data.personId)))
      );
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /churchResources/{resourceId} {
      allow read: if isAdmin() || (isActive() && resource.data.status == 'published');
      allow create: if isAdmin();
      allow update: if isAdmin() || (isActive()
        && resource.data.type == 'prayer_point'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayedByIds'])
        && request.resource.data.prayedByIds.hasAll(resource.data.prayedByIds)
        && request.auth.uid in request.resource.data.prayedByIds
        && request.resource.data.prayedByIds.size() <= resource.data.prayedByIds.size() + 1);
      allow delete: if isAdmin();
    }

    match /churchEvents/{eventId} {
      allow read: if isAdmin() || (isActive() && resource.data.status == 'published');
      allow create, update, delete: if isAdmin();
    }

    match /outreachActivities/{id} {
      allow read: if isAdmin() || isAssignedWorker('workerIds');
      allow create: if isActive()
        && request.resource.data.submittedById == request.auth.uid
        && request.auth.uid in request.resource.data.workerIds;
      allow update: if isAdmin() || (isActive() && resource.data.submittedById == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }
  }
}
