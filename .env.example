VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# EmailJS (instant transactional email only — approvals, password reset
# notices). Bulk/scheduled email was deferred; see README.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Calendar sync (optional). Get this from Google Cloud Console —
# see README "Google Calendar setup" for exact steps. Leave blank to
# disable the feature entirely; the app works fine without it.
VITE_GOOGLE_CLIENT_ID=
